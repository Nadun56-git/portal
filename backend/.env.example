# ── Required ──────────────────────────────────────────────
# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/potrall

# ── Optional ──────────────────────────────────────────────
# Database name (default: potrall)
DB_NAME=potrall
